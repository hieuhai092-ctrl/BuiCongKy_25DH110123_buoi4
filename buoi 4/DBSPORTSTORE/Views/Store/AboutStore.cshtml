
@{
    ViewBag.Title = "Giới thiệu";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<section style="background: white; padding: 32px; border-radius: 16px; margin-top: 28px; box-shadow: 0 4px 12px rgba(15,23,42,0.05);">
    <h2 class="section-title" style="margin-top:0;">Về SportStore</h2>
    <p style="color: #334155; font-size: 16px; line-height: 1.6;">
        SportStore là hệ thống cửa hàng uy tín chuyên cung cấp trang phục, giày dép và các dụng cụ thể thao chính hãng hàng đầu, đáp ứng mọi nhu cầu tập luyện từ cơ bản đến chuyên nghiệp.
    </p>
    <p style="color: #334155; font-size: 16px; line-height: 1.6;">
        Chúng tôi cam kết mang lại những sản phẩm chất lượng cao, giúp bạn nâng cao hiệu suất, bảo vệ sức khỏe và chinh phục mọi mục tiêu thể thao của bản thân.
    </p>
</section>
